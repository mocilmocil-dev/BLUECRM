{
  "entities": {
    "User": {
      "title": "User",
      "description": "User in the CRM system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["GM", "Manager", "Sales"] },
        "managerId": { "type": "string" }
      },
      "required": ["id", "name", "role"]
    },
    "Company": {
      "title": "Company",
      "description": "Company client with PIC contacts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "industry": { "type": "string" },
        "pics": {
          "type": "array"
        }
      },
      "required": ["id", "name", "industry", "pics"]
    },
    "Target": {
      "title": "Target",
      "description": "KPI targets per sales agent per month",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "month": { "type": "string" },
        "productTargets": { "type": "object" }
      },
      "required": ["id", "userId", "month", "productTargets"]
    },
    "Deal": {
      "title": "Deal",
      "description": "CRM pipeline deal record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "companyId": { "type": "string" },
        "picId": { "type": "string" },
        "salesId": { "type": "string" },
        "products": { "type": "array" },
        "stage": { "type": "string" },
        "estimatedValue": { "type": "number" },
        "actualValue": { "type": "number" },
        "lostReason": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "history": { "type": "array" }
      },
      "required": ["id", "title", "companyId", "salesId", "products", "stage", "estimatedValue", "createdAt", "updatedAt"]
    },
    "Unit": {
      "title": "Unit",
      "description": "Vehicle fleet unit managed by operational pools",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "plateNumber": { "type": "string" },
        "model": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string" },
        "maintenanceStatus": { "type": "string" },
        "category": { "type": "string" },
        "assignedDealId": { "type": "string" },
        "notes": { "type": "string" },
        "manufactureYear": { "type": "string" },
        "color": { "type": "string" },
        "transmission": { "type": "string" },
        "fuelLevel": { "type": "number" },
        "taxExpiryDate": { "type": "string" },
        "stnkExpiryDate": { "type": "string" },
        "lastOdometer": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "plateNumber", "model", "location", "status", "category", "updatedAt"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Supir (Driver) managed by operational pools",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string" },
        "category": { "type": "string" },
        "assignedDealId": { "type": "string" },
        "licenseNumber": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "phone", "location", "status", "category", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Client companies list"
    },
    "/targets/{targetId}": {
      "schema": "Target",
      "description": "Sales KPI monthly targets"
    },
    "/deals/{dealId}": {
      "schema": "Deal",
      "description": "Pipeline deals and logs"
    },
    "/units/{unitId}": {
      "schema": "Unit",
      "description": "Vehicle units for mobilized lease and fleet tracking"
    },
    "/drivers/{driverId}": {
      "schema": "Driver",
      "description": "Supir pool drivers"
    }
  }
}
